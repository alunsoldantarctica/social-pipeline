---
import MainLayout from '../layouts/MainLayout.astro';
import { ConvexHttpClient } from 'convex/browser';
import { api } from '../../convex/_generated/api';

const convexUrl = import.meta.env.PUBLIC_CONVEX_URL as string | undefined;
let recentPosts: Array<{
  slug: string;
  title: string;
  excerpt: string;
  imageUrl: string;
  readTimeMinutes: number;
  category: string;
  publishedAt?: number;
}> = [];

if (convexUrl) {
  try {
    const convex = new ConvexHttpClient(convexUrl);
    const posts = await convex.query(api.blogPosts.list, { locale: 'en' });
    recentPosts = posts.slice(0, 3);
  } catch (e) {
    console.warn('[index] failed to fetch blog posts:', e);
  }
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const features = [
  {
    icon: '🔬',
    title: 'Research → Outline → Draft',
    body: 'A 5-stage editorial pipeline with revision loops at every step. Editors approve, revise, or reject — the workflow keeps state across its full lifecycle.',
  },
  {
    icon: '🤖',
    title: 'Per-stage model selection',
    body: 'Swap research, outline, or draft to any OpenRouter or Workers AI model. All inference funnels through Cloudflare AI Gateway for spend caps.',
  },
  {
    icon: '✏️',
    title: 'Editable prompts at runtime',
    body: 'Agent prompts and editorial rules live in the database. Edit at runtime — no redeploy needed. Tune the voice without touching code.',
  },
  {
    icon: '🕵️',
    title: 'Competitor intelligence',
    body: 'Scrape competitor URLs, tag with an LLM, surface content gaps as briefs that feed straight into the pipeline.',
  },
  {
    icon: '💰',
    title: 'Cost tracking',
    body: 'Estimated and actual token spend per workflow, per stage, per model. Reconcile your budget assumptions against reality.',
  },
  {
    icon: '📢',
    title: 'Multi-platform publish',
    body: 'Approve a draft and ship to your blog, X, LinkedIn, or newsletter audience — all from the same review interface.',
  },
];

const stages = [
  { label: 'Research', sub: 'Web scraping + sources', color: '#60a5fa' },
  { label: 'Outline', sub: 'Structure + key points', color: '#a78bfa' },
  { label: 'Draft', sub: 'Full article generation', color: '#c084fc' },
  { label: 'Review', sub: 'Editorial approval gate', color: '#f472b6' },
  { label: 'Publish', sub: 'Multi-platform delivery', color: '#34d399' },
];

const mockWorkflows = [
  { title: 'How AI Is Transforming B2B Content Marketing in 2025', status: 'Draft Review', statusClass: 'badge-amber', cost: '$0.031' },
  { title: 'The Ultimate Guide to LLM Prompt Engineering', status: 'Researching', statusClass: 'badge-blue', cost: '$0.008' },
  { title: '10 Ways to Reduce Customer Churn in SaaS', status: 'Research Review', statusClass: 'badge-amber', cost: '$0.014' },
  { title: 'Cloudflare Workers vs. AWS Lambda: A Deep Dive', status: 'Completed', statusClass: 'badge-green', cost: '$0.024' },
  { title: 'Building a Headless CMS with Convex and Astro', status: 'Outlining', statusClass: 'badge-blue', cost: '$0.006' },
];
---

<MainLayout
  title="social-pipeline"
  description="An AI content pipeline scaffold — research, outline, draft, publish."
>
  <style is:global>
    body {
      background: #030712;
      color: white;
    }

    .gradient-text {
      background: linear-gradient(135deg, #e879f9 0%, #a78bfa 45%, #38bdf8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .glass {
      background: rgba(255, 255, 255, 0.04);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.03);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.07);
      border-radius: 16px;
      position: relative;
      overflow: hidden;
      transition: background 0.2s ease, border-color 0.2s ease;
    }

    .glass-card:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.12);
    }

    .glass-card::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 16px;
      padding: 1px;
      background: linear-gradient(
        135deg,
        rgba(168, 85, 247, 0.3) 0%,
        rgba(59, 130, 246, 0.15) 50%,
        rgba(6, 182, 212, 0.2) 100%
      );
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
    }

    .glow-purple {
      box-shadow: 0 0 80px rgba(168, 85, 247, 0.12), 0 0 160px rgba(168, 85, 247, 0.04);
    }

    .glow-blue {
      box-shadow: 0 0 80px rgba(56, 189, 248, 0.1), 0 0 160px rgba(56, 189, 248, 0.03);
    }

    @keyframes sp-float {
      0%, 100% { transform: translate(0, 0) scale(1); }
      33%  { transform: translate(40px, -30px) scale(1.04); }
      66%  { transform: translate(-25px, 20px) scale(0.97); }
    }

    @keyframes sp-float2 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      33%  { transform: translate(-35px, 25px) scale(1.03); }
      66%  { transform: translate(20px, -15px) scale(0.98); }
    }

    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
    }

    .orb-1 {
      width: 700px; height: 700px;
      background: radial-gradient(circle, rgba(168, 85, 247, 0.2) 0%, transparent 65%);
      top: -300px; left: -200px;
      animation: sp-float 14s ease-in-out infinite;
    }

    .orb-2 {
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(56, 189, 248, 0.15) 0%, transparent 65%);
      top: 0; right: -200px;
      animation: sp-float2 11s ease-in-out infinite;
    }

    .orb-3 {
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(236, 72, 153, 0.12) 0%, transparent 65%);
      bottom: 0; left: 30%;
      animation: sp-float 16s ease-in-out infinite;
      animation-delay: -6s;
    }

    .glass-nav {
      background: rgba(3, 7, 18, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .cta-primary {
      background: linear-gradient(135deg, rgba(168, 85, 247, 0.9) 0%, rgba(59, 130, 246, 0.9) 100%);
      border: 1px solid rgba(168, 85, 247, 0.4);
      color: white;
      position: relative;
      overflow: hidden;
    }

    .cta-primary:hover {
      background: linear-gradient(135deg, #a855f7 0%, #3b82f6 100%);
    }

    /* ── App mockup ─────────────────────────────────────────── */
    .mock-wrap {
      background: rgba(10, 10, 20, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 20px;
      overflow: hidden;
    }

    .mock-titlebar {
      background: rgba(255, 255, 255, 0.03);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      padding: 10px 16px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .mock-dots { display: flex; gap: 6px; }

    .mock-dot {
      width: 10px; height: 10px; border-radius: 50%;
    }

    .mock-urlbar {
      flex: 1;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 6px;
      padding: 3px 10px;
      font-size: 11px;
      color: rgba(255,255,255,0.35);
      font-family: ui-monospace, monospace;
    }

    .mock-app {
      display: flex;
      height: 400px;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    .mock-sidebar {
      width: 196px;
      background: rgba(0, 0, 0, 0.35);
      border-right: 1px solid rgba(255,255,255,0.05);
      padding: 20px 0;
      flex-shrink: 0;
    }

    .mock-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 0 16px 20px;
    }

    .mock-brand-dot {
      width: 24px; height: 24px;
      border-radius: 6px;
      background: linear-gradient(135deg, #a855f7, #3b82f6);
    }

    .mock-brand-name {
      font-size: 12px;
      font-weight: 600;
      color: rgba(255,255,255,0.8);
      letter-spacing: -0.01em;
    }

    .mock-section-label {
      padding: 0 16px 6px;
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.25);
    }

    .mock-nav-item {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 7px 16px;
      color: rgba(255,255,255,0.45);
      font-size: 12px;
      cursor: default;
    }

    .mock-nav-item.active {
      background: rgba(168, 85, 247, 0.12);
      color: rgba(255,255,255,0.9);
      border-left: 2px solid #a855f7;
    }

    .mock-nav-dot {
      width: 14px; height: 14px; border-radius: 4px; flex-shrink: 0;
    }

    .mock-main {
      flex: 1;
      background: rgba(0,0,0,0.15);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .mock-main-header {
      padding: 14px 20px;
      border-bottom: 1px solid rgba(255,255,255,0.05);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    }

    .mock-title { font-size: 14px; font-weight: 600; color: rgba(255,255,255,0.9); }

    .mock-new-btn {
      background: rgba(168, 85, 247, 0.25);
      border: 1px solid rgba(168, 85, 247, 0.4);
      color: rgba(255,255,255,0.85);
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 10px;
      font-weight: 500;
      cursor: default;
    }

    .mock-filters {
      display: flex;
      gap: 4px;
      padding: 8px 20px;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      flex-shrink: 0;
    }

    .mock-pill {
      padding: 2px 9px;
      border-radius: 20px;
      font-size: 10px;
      border: 1px solid rgba(255,255,255,0.09);
      color: rgba(255,255,255,0.4);
      cursor: default;
    }

    .mock-pill.active {
      background: rgba(255,255,255,0.07);
      color: rgba(255,255,255,0.75);
      border-color: rgba(255,255,255,0.18);
    }

    .mock-row {
      display: flex;
      align-items: center;
      padding: 11px 20px;
      border-bottom: 1px solid rgba(255,255,255,0.035);
      gap: 12px;
      flex-shrink: 0;
    }

    .mock-row-title {
      flex: 1;
      font-size: 12px;
      color: rgba(255,255,255,0.8);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .mock-badge {
      padding: 2px 8px;
      border-radius: 10px;
      font-size: 10px;
      font-weight: 500;
      flex-shrink: 0;
    }

    .badge-amber { background: rgba(251,191,36,0.12); color: #fbbf24; border: 1px solid rgba(251,191,36,0.25); }
    .badge-blue  { background: rgba(96,165,250,0.12); color: #60a5fa; border: 1px solid rgba(96,165,250,0.25); }
    .badge-green { background: rgba(52,211,153,0.12); color: #34d399; border: 1px solid rgba(52,211,153,0.25); }

    .mock-cost {
      font-size: 10px;
      color: rgba(255,255,255,0.28);
      font-family: ui-monospace, monospace;
      flex-shrink: 0;
    }
  </style>

  <!-- ── Navigation ─────────────────────────────────────────── -->
  <header class="glass-nav sticky top-0 z-50">
    <div style="max-width:1152px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;">
      <div style="display:flex;align-items:center;gap:8px;">
        <div style="width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#a855f7,#3b82f6);flex-shrink:0;"></div>
        <span style="font-weight:600;color:white;font-size:14px;letter-spacing:-0.02em;">social-pipeline</span>
      </div>
      <nav style="display:flex;align-items:center;gap:24px;font-size:13px;color:rgba(255,255,255,0.55);">
        <a href="#features" style="color:inherit;text-decoration:none;transition:color 0.15s;" onmouseover="this.style.color='rgba(255,255,255,0.9)'" onmouseout="this.style.color='rgba(255,255,255,0.55)'">Features</a>
        <a href="#pipeline" style="color:inherit;text-decoration:none;transition:color 0.15s;" onmouseover="this.style.color='rgba(255,255,255,0.9)'" onmouseout="this.style.color='rgba(255,255,255,0.55)'">Pipeline</a>
        <a href="/blog" style="color:inherit;text-decoration:none;transition:color 0.15s;" onmouseover="this.style.color='rgba(255,255,255,0.9)'" onmouseout="this.style.color='rgba(255,255,255,0.55)'">Blog</a>
      </nav>
      <a href="/admin" class="cta-primary" style="display:inline-flex;align-items:center;gap:6px;padding:8px 18px;border-radius:10px;font-size:13px;font-weight:600;text-decoration:none;transition:opacity 0.15s;">
        Open Admin
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </header>

  <!-- ── Hero ───────────────────────────────────────────────── -->
  <section style="position:relative;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:120px 24px 80px;overflow:hidden;text-align:center;">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <div style="position:relative;z-index:10;max-width:900px;width:100%;">
      <!-- Badge -->
      <div class="glass" style="display:inline-flex;align-items:center;gap:8px;border-radius:100px;padding:6px 16px;margin-bottom:32px;">
        <span style="width:7px;height:7px;border-radius:50%;background:#a855f7;display:block;animation:pulse 2s infinite;"></span>
        <span style="font-size:12px;font-weight:500;color:rgba(255,255,255,0.65);letter-spacing:0.04em;">Open-source AI Content Pipeline</span>
      </div>

      <!-- Headline -->
      <h1 style="font-size:clamp(44px,8vw,80px);font-weight:800;line-height:1.05;letter-spacing:-0.03em;margin-bottom:24px;">
        <span style="color:white;">From topic to</span><br/>
        <span class="gradient-text">published post</span><br/>
        <span style="color:white;">on autopilot.</span>
      </h1>

      <!-- Sub -->
      <p style="font-size:18px;color:rgba(255,255,255,0.5);max-width:580px;margin:0 auto 40px;line-height:1.7;">
        A complete editorial pipeline on Astro, Convex and Cloudflare Workers.
        Research, outline, draft and publish — with per-stage AI model selection
        and real editorial control at every step.
      </p>

      <!-- CTAs -->
      <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:12px;margin-bottom:64px;">
        <a href="/admin" class="cta-primary" style="display:inline-flex;align-items:center;gap:8px;padding:14px 28px;border-radius:14px;font-size:15px;font-weight:700;text-decoration:none;transition:opacity 0.15s;">
          Open Admin Dashboard
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/blog" class="glass" style="display:inline-flex;align-items:center;gap:8px;padding:14px 28px;border-radius:14px;font-size:15px;font-weight:600;text-decoration:none;color:rgba(255,255,255,0.7);transition:all 0.15s;" onmouseover="this.style.color='white'" onmouseout="this.style.color='rgba(255,255,255,0.7)'">
          View Blog
        </a>
      </div>

      <!-- Pipeline stages preview -->
      <div id="pipeline" style="display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:8px;">
        {stages.map((stage, i) => (
          <div style="display:flex;align-items:center;gap:8px;">
            <div class="glass" style={`border-radius:12px;padding:12px 18px;text-align:center;min-width:100px;border-color:${stage.color}22;`}>
              <div style={`font-size:12px;font-weight:700;color:${stage.color};margin-bottom:2px;`}>{stage.label}</div>
              <div style="font-size:10px;color:rgba(255,255,255,0.35);white-space:nowrap;">{stage.sub}</div>
            </div>
            {i < stages.length - 1 && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── App mockup section ─────────────────────────────────── -->
  <section style="padding:80px 24px;position:relative;">
    <div style="max-width:1100px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:48px;">
        <h2 style="font-size:clamp(28px,5vw,44px);font-weight:800;letter-spacing:-0.03em;color:white;margin-bottom:14px;">
          Built for <span class="gradient-text">editorial control</span>
        </h2>
        <p style="color:rgba(255,255,255,0.45);font-size:15px;max-width:480px;margin:0 auto;line-height:1.7;">
          Every workflow moves through approval gates. Editors review, revise, or reject at each stage — the pipeline tracks full state.
        </p>
      </div>

      <!-- Browser frame mockup -->
      <div class="mock-wrap glow-purple">
        <div class="mock-titlebar">
          <div class="mock-dots">
            <div class="mock-dot" style="background:#ff5f57;"></div>
            <div class="mock-dot" style="background:#febc2e;"></div>
            <div class="mock-dot" style="background:#28c840;"></div>
          </div>
          <div class="mock-urlbar">social-pipeline.workers.dev/admin/content</div>
        </div>
        <div class="mock-app">
          <!-- Sidebar -->
          <div class="mock-sidebar">
            <div class="mock-brand">
              <div class="mock-brand-dot"></div>
              <span class="mock-brand-name">social-pipeline</span>
            </div>
            <div class="mock-section-label">Workspace</div>
            <div class="mock-nav-item active">
              <div class="mock-nav-dot" style="background:rgba(168,85,247,0.8);"></div>
              Content
            </div>
            <div class="mock-nav-item">
              <div class="mock-nav-dot" style="background:rgba(255,255,255,0.3);"></div>
              Analytics
            </div>
            <div class="mock-nav-item">
              <div class="mock-nav-dot" style="background:rgba(255,255,255,0.3);"></div>
              Settings
            </div>
          </div>
          <!-- Main area -->
          <div class="mock-main">
            <div class="mock-main-header">
              <div class="mock-title">Content Pipeline</div>
              <div class="mock-new-btn">+ New Workflow</div>
            </div>
            <div class="mock-filters">
              <div class="mock-pill active">All</div>
              <div class="mock-pill">Pending Review</div>
              <div class="mock-pill">In Progress</div>
              <div class="mock-pill">Completed</div>
            </div>
            {mockWorkflows.map(wf => (
              <div class="mock-row">
                <div class="mock-row-title">{wf.title}</div>
                <div class={`mock-badge ${wf.statusClass}`}>{wf.status}</div>
                <div class="mock-cost">{wf.cost}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Features grid ─────────────────────────────────────── -->
  <section id="features" style="padding:80px 24px;">
    <div style="max-width:1100px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:56px;">
        <h2 style="font-size:clamp(28px,5vw,44px);font-weight:800;letter-spacing:-0.03em;color:white;margin-bottom:12px;">
          What's in the box
        </h2>
        <p style="color:rgba(255,255,255,0.4);font-size:14px;">Everything you need to run an AI content operation.</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px;">
        {features.map(f => (
          <div class="glass-card" style="padding:28px;">
            <div style="font-size:24px;margin-bottom:14px;">{f.icon}</div>
            <h3 style="font-size:15px;font-weight:700;color:rgba(255,255,255,0.9);margin-bottom:8px;">{f.title}</h3>
            <p style="font-size:13px;color:rgba(255,255,255,0.45);line-height:1.65;">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Tech stack ─────────────────────────────────────────── -->
  <section style="padding:48px 24px;border-top:1px solid rgba(255,255,255,0.05);">
    <div style="max-width:800px;margin:0 auto;text-align:center;">
      <p style="font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.25);margin-bottom:24px;">Built on</p>
      <div style="display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:32px;">
        {['Astro', 'Convex', 'Cloudflare Workers', 'OpenRouter', 'Resend'].map(tech => (
          <span style="font-size:14px;font-weight:500;color:rgba(255,255,255,0.35);">{tech}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────── -->
  <section style="padding:80px 24px;">
    <div style="max-width:600px;margin:0 auto;">
      <div class="glass-card glow-blue" style="padding:56px 40px;text-align:center;">
        <h2 style="font-size:clamp(28px,5vw,40px);font-weight:800;letter-spacing:-0.03em;color:white;margin-bottom:14px;">
          Ready to ship?
        </h2>
        <p style="color:rgba(255,255,255,0.45);font-size:15px;margin-bottom:32px;line-height:1.7;">
          Configure your niche, customize the prompts, and let the pipeline
          turn topics into review-ready drafts.
        </p>
        <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:12px;">
          <a href="/admin" class="cta-primary" style="display:inline-flex;align-items:center;gap:8px;padding:14px 28px;border-radius:12px;font-size:15px;font-weight:700;text-decoration:none;">
            Open Admin Dashboard
          </a>
          <a href="/blog" class="glass" style="display:inline-flex;align-items:center;padding:14px 28px;border-radius:12px;font-size:15px;font-weight:600;text-decoration:none;color:rgba(255,255,255,0.65);">
            View Blog
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Recent posts ───────────────────────────────────────── -->
  {recentPosts.length > 0 && (
    <section style="padding:80px 24px;border-top:1px solid rgba(255,255,255,0.05);">
      <div style="max-width:1100px;margin:0 auto;">
        <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:40px;flex-wrap:wrap;gap:12px;">
          <h2 style="font-size:28px;font-weight:800;color:white;letter-spacing:-0.02em;">Latest from the blog</h2>
          <a href="/blog" style="font-size:13px;color:#a78bfa;text-decoration:none;font-weight:600;">See all posts →</a>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;">
          {recentPosts.map((post) => (
            <a href={`/blog/${post.slug}`} class="glass-card" style="display:block;text-decoration:none;overflow:hidden;">
              <div style="aspect-ratio:16/9;background:rgba(255,255,255,0.04);overflow:hidden;">
                <img
                  src={post.imageUrl}
                  alt={post.title}
                  style="width:100%;height:100%;object-fit:cover;opacity:0.75;transition:transform 0.5s ease;"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div style="padding:20px;">
                <div style="display:flex;align-items:center;gap:10px;font-size:11px;color:rgba(255,255,255,0.3);margin-bottom:10px;">
                  <span style="padding:2px 8px;background:rgba(255,255,255,0.05);border-radius:20px;">{post.category}</span>
                  <span>{post.readTimeMinutes} min read</span>
                </div>
                <h3 style="font-size:14px;font-weight:700;color:rgba(255,255,255,0.85);margin-bottom:6px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{post.title}</h3>
                <p style="font-size:12px;color:rgba(255,255,255,0.38);line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{post.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── Footer ─────────────────────────────────────────────── -->
  <footer style="border-top:1px solid rgba(255,255,255,0.05);padding:28px 24px;">
    <div style="max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div style="display:flex;align-items:center;gap:8px;">
        <div style="width:20px;height:20px;border-radius:6px;background:linear-gradient(135deg,#a855f7,#3b82f6);"></div>
        <span style="font-size:13px;color:rgba(255,255,255,0.3);font-weight:500;">social-pipeline</span>
      </div>
      <div style="display:flex;align-items:center;gap:20px;font-size:12px;color:rgba(255,255,255,0.28);">
        <a href="/blog" style="color:inherit;text-decoration:none;">Blog</a>
        <a href="/admin" style="color:inherit;text-decoration:none;">Admin</a>
        <a href="https://github.com/alunsoldantarctica/social-pipeline" style="color:inherit;text-decoration:none;">GitHub</a>
      </div>
    </div>
  </footer>
</MainLayout>
