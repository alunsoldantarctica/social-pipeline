# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ===== Convex =====
# Set automatically by `pnpx convex dev` — usually in .env.local already
CONVEX_DEPLOYMENT=dev:your-deployment-name

# ===== Cloudflare AI Gateway =====
# Gateway slug (not the full URL — e.g. "my-gateway")
# Create at: Cloudflare Dashboard → AI Gateway
CF_AI_GATEWAY_NAME=your-gateway-slug

# Your Cloudflare account ID (from dashboard URL or account home)
CF_ACCOUNT_ID=your_cloudflare_account_id

# ===== Cloudflare Images =====
# API token with Images:Edit permission
# Create at: Cloudflare Dashboard → My Profile → API Tokens
CF_IMAGES_TOKEN=your_cloudflare_images_token

# ===== OpenRouter =====
# Required if using OpenRouter models (Perplexity Sonar for research)
# Get at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# ===== Firecrawl =====
# Required for the research agent's web search/scrape tools
# Get at: https://firecrawl.dev
FIRECRAWL_API_KEY=fc-...

# ===== Auth =====
# Secret key used by Convex Auth for email OTP (Resend)
# Get at: https://resend.com/api-keys
AUTH_RESEND_KEY=re_...

# Used to sign the OTP log endpoint calls
# Generate: openssl rand -hex 32
AUTH_RESEND_SECRET=your_random_secret_hex

# ===== Web Push (VAPID) =====
# Generate keys: npx web-push generate-vapid-keys
# Public key also goes in wrangler.toml [vars] PUBLIC_VAPID_KEY
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# ===== Zernio Social Publishing (optional) =====
# Get at: https://zernio.com → Settings → API
ZERNIO_API_KEY=sk_...
